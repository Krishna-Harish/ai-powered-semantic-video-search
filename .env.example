# Copy this file to ".env" (same folder) and fill in your values.
# .env is in .gitignore, so your key is never committed to GitHub.
# Restart the backend after editing it.

# Free Gemini key from https://aistudio.google.com/apikey
# Leave empty to use a local Ollama model instead.
GEMINI_API_KEY=

# Optional settings (uncomment to change):
# LLM_PROVIDER=auto          # auto | gemini | ollama
# GEMINI_MODEL=gemini-flash-latest
# OLLAMA_MODEL=llama3.2
# WHISPER_MODEL=small        # base is 2-3x faster, less accurate
